<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: serverdan yuklangan resurslar bulutga va boshqa qurilmaga ko'chirilmasin -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="resources/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="resources/" />
    </device-transfer>
</data-extraction-rules>
